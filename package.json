{
  "name": "intai-fa",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "プロ野球去就アーカイブ — NPB の引退・戦力外・FA・移籍・指導者人事を年度別と人物別に",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check": "tsx scripts/check/index.ts",
    "check:urls": "tsx scripts/check/index.ts --urls",
    "seo": "node scripts/seo-check.mjs dist https://satory074.github.io/intai-fa/ --require-backlink",
    "import:npb": "tsx scripts/import/npb-announcements.ts",
    "import:register": "tsx scripts/import/npb-register.ts",
    "import:profiles": "tsx scripts/import/npb-profiles.ts",
    "edit": "tsx scripts/edit-server.ts",
    "todo": "tsx scripts/todo.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "node-html-parser": "^9.0.7",
    "pagefind": "^1.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
