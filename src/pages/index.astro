---
import Layout from "../components/Layout.astro";
import { dataset } from "../lib/data";
import { coverage, rowsForSeason, SECTIONS } from "../lib/rows";
import { approxPeople, ymd } from "../lib/format";

const ds = dataset();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const latest = ds.seasons[0];
const latestRows = rowsForSeason(latest);
const latestCounts = SECTIONS.map((s) => ({ ...s, n: latestRows.filter((r) => r.section === s.key).length })).filter((s) => s.n > 0);
const prevSeason = ds.seasons[1];

// 年の一覧を 10 年ごとに（新しい順）
const decades = new Map<number, { season: number; people: number; pct: number }[]>();
for (const s of ds.seasons) {
  const rows = rowsForSeason(s);
  const d = Math.floor(s / 10) * 10;
  decades.set(d, [...(decades.get(d) ?? []), { season: s, people: new Set(rows.map((r) => r.personId)).size, pct: coverage(rows).pct }]);
}
const title = "プロ野球去就アーカイブ";
const description = `プロ野球（NPB）の引退・戦力外・FA・トレード・監督コーチ人事を、${ds.seasons[ds.seasons.length - 1]}年から年度別・球団別・人物別に。${approxPeople(ds.people.size)}の在籍球団の変遷つき。出典はNPB公示・球団発表・在籍者名簿。`;
---

<Layout title={title} description={description}>
  <h1 class="page-title">プロ野球の去就を、年ごとに。</h1>
  <p class="lede">
    引退・戦力外・FA・トレード・現役ドラフト・監督とコーチの人事を、年度別・球団別・人物別にまとめています。どの選手がどの球団を渡ってきたかは、人物ページの帯で見られます。どの行にも出典を付けています。
  </p>

  <section class="fresh" aria-labelledby="now-h">
    <h2 id="now-h"><a href={`${base}/${latest}/`}>{latest}年オフ</a>の去就</h2>
    <ul>
      {latestCounts.map((c) => <li><a href={`${base}/${latest}/#${c.key}`}>{c.title}</a> {c.n}{c.key === "staff" ? "件" : "人"}</li>)}
    </ul>
    <p class="meta-line">
      最終更新 {ymd(ds.updated)}。{prevSeason && <a href={`${base}/${prevSeason}/`}>{prevSeason}年オフ</a>}
    </p>
  </section>

  <form class="search" action={`${base}/people/`} method="get" role="search">
    <label for="q">名前で人物をさがす</label>
    <input id="q" name="q" type="search" placeholder="例: 矢野 謙次" autocomplete="off" />
  </form>

  <section class="spines" aria-labelledby="years-h">
    <h2 id="years-h" class="sr-only">年の一覧</h2>
    {
      [...decades.entries()].map(([d, list]) => (
        <div class="decade">
          <span class="decade-label">{d}年代</span>
          <ol>
            {list.map((y) => (
              <li>
                <a class={`spine ${y.season === latest ? "current" : ""}`} href={`${base}/${y.season}/`} aria-label={`${y.season}年オフ ${y.people}人`}>
                  <span class="y">{y.season}</span>
                  <span class="n">{y.people}人</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>
</Layout>
