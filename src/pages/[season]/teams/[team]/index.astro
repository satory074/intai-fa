---
/**
 * 旧 URL（2026-11 まで: /{年度}/teams/{球団}/）の転送。球団×年度のページは /teams/{球団}/{年度}/ に移した。
 * 作るのは新しいページと同じ組み合わせだけ（teamSeasons）。
 */
import Redirect from "../../../../components/Redirect.astro";
import { teamSeasons } from "../../../../lib/rows";
import { franchises, shortOf } from "../../../../lib/teams";

export function getStaticPaths() {
  return franchises().flatMap((f) => teamSeasons(f.id).map((season) => ({ params: { season: String(season), team: f.id } })));
}

const season = Number(Astro.params.season);
const team = Astro.params.team!;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Redirect to={`${base}/teams/${team}/${season}/`} title={`${season}年オフ ${shortOf(team, season)}の去就`} />
