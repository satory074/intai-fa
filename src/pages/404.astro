---
import Layout from "../components/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="ページが見つかりません" description="このアドレスのページはありません。" noindex>
  <h1 class="page-title">ページが見つかりません</h1>
  <p class="lede">アドレスが変わったか、まだ作っていないページです。<a href={`${base}/`}>トップ（今オフの動きと年度の一覧）</a>、<a href={`${base}/teams/`}>球団の一覧</a>、<a href={`${base}/people/`}>人物をさがす</a>からたどってください。</p>
</Layout>
