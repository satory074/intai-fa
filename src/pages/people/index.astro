---
/** 人物をさがす: 名前の検索（SearchBox、?q= を読む）＋五十音の索引（JS が無くてもすべての人物ページへたどれる） */
import Layout from "../../components/Layout.astro";
import SearchBox from "../../components/SearchBox.astro";
import { dataset } from "../../lib/data";
import { KANA_ROWS } from "../../lib/kana";
import { approxPeople } from "../../lib/format";

const ds = dataset();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const counts = new Map<string, number>();
for (const p of ds.people.values()) if (p.kanaRow) counts.set(p.kanaRow, (counts.get(p.kanaRow) ?? 0) + 1);
---

<Layout
  title="人物をさがす"
  description={`プロ野球の選手・監督・コーチ${approxPeople(ds.people.size)}から、名前で人物をさがす。五十音の索引もあります。`}
  crumbs={[{ label: "人物" }]}
>
  <h1 class="page-title">人物をさがす</h1>
  <SearchBox id="q" readQuery />
  <noscript><p class="empty">名前の検索には JavaScript が必要です。下の五十音の索引からもさがせます。</p></noscript>

  <section aria-labelledby="kana-h">
    <h2 id="kana-h" class="section-head">五十音の索引</h2>
    <p class="link-row">
      {KANA_ROWS.map((k) => counts.get(k.label) ? <a href={`${base}/names/${k.key}/`}>{k.label}（{counts.get(k.label)}）</a> : null)}
    </p>
  </section>
</Layout>
