---
/**
 * 区分ごとの表。caption を付け、名前のセルを行見出し（th scope=row）にする。
 *
 * 幅の広い画面では普通の表。表の置かれた幅が 40rem 未満になると（@container、global.css）1 行を 1 枚に組み替え、
 * thead を隠して、各セルの data-label（列名）をセルの前に出す。だから th と td の列名は必ず同じにすること。
 * 組み替えたときに先に出すセル（区分・その後など）には class="lead" を付ける。
 * container query を使えないブラウザでは、普通の表を横に送って読む（表全体は role=region・tabindex=0 で包む）。
 * data-* は絞り込み（区分・球団・育成）用。JS が無くても全行が見える。
 */
import type { Row, SectionKey } from "../lib/rows";
import { md } from "../lib/format";
import { dataset } from "../lib/data";
import Team from "./Team.astro";
import Tags from "./Tags.astro";
import Sources from "./Sources.astro";

interface Props {
  rows: Row[];
  section: SectionKey;
  title: string;
  season: number;
  /** 球団×年ページでは球団へのリンクを付けない */
  teamLinks?: boolean;
}
const { rows, section, title, season, teamLinks = true } = Astro.props;
const registerAsOf = dataset().registerAsOf;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const capId = `cap-${section}`;
const main = rows.filter((r) => !r.minor);
const minor = rows.filter((r) => r.minor);
const ikuseiCount = rows.filter((r) => r.ikusei).length;
const countText = section === "staff" ? `${rows.length}件` : `${rows.length}人${ikuseiCount ? `（うち育成${ikuseiCount}人）` : ""}`;
const teamsAttr = (r: Row) => [r.team, r.toTeam, r.outcomeTeam].filter(Boolean).join(" ");
const person = (r: Row) => `${base}/people/${r.personId}/`;
const thisYear = new Date().getFullYear();
const after = (r: Row) => r.outcome ?? (section === "fa" ? (season >= thisYear ? "交渉中" : "") : section === "retire" ? "" : "未定");

const COLS: Record<"staff" | "move" | "fa" | "default", string[]> = {
  staff: ["日付", "球団", "名前", "内容", "出典"],
  move: ["日付", "区分", "名前", "位置", "移籍元", "移籍先", "出典"],
  fa: ["日付", "球団", "名前", "位置", "年齢", "区分", "結果", "出典"],
  default: ["日付", "球団", "名前", "位置", "年齢", "在籍", "区分", "その後", "出典"],
};
const cols = COLS[section === "staff" || section === "move" || section === "fa" ? section : "default"];
const NUM_COLS = new Set(["年齢", "在籍"]);
---

<section class="section" id={section} data-section={section}>
  <h2 id={capId}>{title} <span class="count" data-count>{countText}</span></h2>
  {(section === "retire" || section === "release") && season > registerAsOf && (
    <p class="section-note">「在籍」は在籍者名簿（{registerAsOf}年シーズン終了時）までの選手としての年数で、{season}年は含みません。</p>
  )}
  {section === "departure" && <p class="section-note">在籍者名簿で、その球団での最後の年がこの年度だった人です。引退か戦力外かなどの理由はまだ調べていません。</p>}
  {section === "release" && <p class="section-note">「保留されない選手」は 12 月の契約保留選手名簿に載らなかった選手で、戦力外・引退・退団のどれかは公示だけではわかりません。わかったものから「理由未調査」の印が消えます。</p>}
  <div class="table-wrap" role="region" aria-labelledby={capId} tabindex="0">
    <table class="record">
      <caption class="sr-only">{season}年オフ {title}</caption>
      <thead>
        <tr>{cols.map((c) => <th scope="col" class={NUM_COLS.has(c) ? "num" : undefined}>{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          main.map((r) => (
            <tr data-teams={teamsAttr(r)} data-ikusei={r.ikusei ? "1" : "0"}>
              <td class="date" data-label="日付">{md(r.date)}</td>
              {section === "move" ? (
                <>
                  <td class="lead" data-label="区分">{r.label}</td>
                  <th scope="row"><a href={person(r)}>{r.person.name}</a><Tags row={r} /></th>
                  <td data-label="位置">{r.pos ?? ""}</td>
                  <td class="team" data-label="移籍元"><Team id={r.team} season={season} link={teamLinks} /></td>
                  <td class="team lead" data-label="移籍先">{r.toTeam ? <Team id={r.toTeam} season={season} link={teamLinks} /> : r.outcome}</td>
                </>
              ) : section === "staff" ? (
                <>
                  <td class="team" data-label="球団"><Team id={r.team} season={season} link={teamLinks} /></td>
                  <th scope="row"><a href={person(r)}>{r.person.name}</a><Tags row={r} /></th>
                  <td class="lead" data-label="内容">{r.label}</td>
                </>
              ) : (
                <>
                  <td class="team" data-label="球団"><Team id={r.team} season={season} link={teamLinks} /></td>
                  <th scope="row"><a href={person(r)}>{r.person.name}</a><Tags row={r} /></th>
                  <td data-label="位置">{r.pos ?? ""}</td>
                  <td class="num" data-label="年齢">{r.age ?? ""}</td>
                  {section !== "fa" && <td class="num" data-label="在籍">{r.years ? `${r.years}年` : ""}</td>}
                  <td class="lead" data-label="区分">{r.label}</td>
                  <td class="lead" data-label={section === "fa" ? "結果" : "その後"}>{after(r)}</td>
                </>
              )}
              <td class="src" data-label="出典"><Sources sources={r.sources} /></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {
    minor.length > 0 && (
      <details class="minor">
        <summary>同じ球団内の配置転換 {minor.length}件</summary>
        <div class="table-wrap" role="region" aria-label={`${title}の配置転換`} tabindex="0">
          <table class="record">
            <caption class="sr-only">{season}年オフ 配置転換</caption>
            <thead>
              <tr>{COLS.staff.map((c) => <th scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              {minor.map((r) => (
                <tr data-teams={teamsAttr(r)} data-ikusei="0">
                  <td class="date" data-label="日付">{md(r.date)}</td>
                  <td class="team" data-label="球団"><Team id={r.team} season={season} link={teamLinks} /></td>
                  <th scope="row"><a href={person(r)}>{r.person.name}</a><Tags row={r} /></th>
                  <td class="lead" data-label="内容">{r.label}</td>
                  <td class="src" data-label="出典"><Sources sources={r.sources} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )
  }
</section>
