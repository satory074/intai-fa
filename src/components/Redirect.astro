---
/**
 * URL を移したページの転送（GitHub Pages はサーバーで転送できないので meta refresh）。
 * 検索には出さない（noindex・サイトマップから外す: astro.config.mjs）。canonical は移った先。
 * seo-check は noindex のページにも title と戻りリンクの帯を求めるので、Astro の redirects ではなくこの部品で作る。
 */
import "../styles/global.css";

interface Props {
  /** 移った先（base を含むパス。例: /intai-fa/teams/giants/2025/） */
  to: string;
  title: string;
}
const { to, title } = Astro.props;
const target = new URL(to, Astro.site).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}（移転しました） | プロ野球去就アーカイブ</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <main class="wrap">
      <p class="lede">このページは <a href={to}>{title}</a> に移りました。</p>
    </main>
    <nav class="app-backlink-bar" aria-label="サイト間ナビゲーション">
      <a href="https://satory074.com/apps/" target="_blank" rel="noopener" aria-label="satory074 のほかのアプリ一覧を新しいタブで開く"
        >satory074 のほかのアプリ <span aria-hidden="true">↗</span></a
      >
    </nav>
  </body>
</html>
