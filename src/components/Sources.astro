---
import type { Source } from "../lib/schema";
import { sourceLabel } from "../lib/format";
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---

{
  sources.map((s) => (
    <a href={s.url} rel="noopener nofollow" target="_blank" title={s.title ?? sourceLabel(s)}>
      {sourceLabel(s)}
    </a>
  ))
}
